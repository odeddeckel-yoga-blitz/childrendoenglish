#!/bin/sh
# Production push budget (owner, 2026-10-31): every push to main is a Vercel production
# build, and production builds are ~85% of build cost (46 prod deploys Oct 24–31). So a
# push to main that changes more than docs needs >=120 min since the last one and at most
# 4 per UTC day. Branch/preview pushes and docs-only pushes are not counted. Batch commits:
# they all go up together in the next allowed push.
#   Urgent fix for a broken live page:  CDE_PUSH_NOW=1 git push
#   Change the window / daily cap:      CDE_PUSH_GAP_MIN=60 CDE_PUSH_DAY_MAX=5 git push
GAP_MIN="${CDE_PUSH_GAP_MIN:-120}"
DAY_MAX="${CDE_PUSH_DAY_MAX:-4}"
LOG="$(git rev-parse --git-dir)/prod-push-log"   # one epoch second per production push
ZERO=0000000000000000000000000000000000000000

prod=0
while read -r lref lsha rref rsha; do
  [ "$rref" = "refs/heads/main" ] || continue
  [ "$lsha" = "$ZERO" ] && continue
  base="$rsha"; [ "$base" = "$ZERO" ] && base="$(git merge-base "$lsha" origin/main 2>/dev/null)"
  # docs-only (markdown / docs/) doesn't build anything worth a deploy
  if git diff --name-only "$base" "$lsha" 2>/dev/null | grep -qvE '(\.md$|^docs/)'; then prod=1; fi
done
[ "$prod" = 1 ] || exit 0

now=$(date +%s)
today=$(date -u +%Y-%m-%d)
if [ "${CDE_PUSH_NOW:-0}" != "1" ] && [ -f "$LOG" ]; then
  last=$(tail -n 1 "$LOG" 2>/dev/null || echo 0)
  age=$(( (now - last) / 60 ))
  if [ "$age" -lt "$GAP_MIN" ]; then
    echo "⏳ production push budget: the last push to main was ${age} min ago; the next is allowed in $(( GAP_MIN - age )) min." >&2
    echo "   Commits stay safe locally and go up together then. Broken live page: CDE_PUSH_NOW=1 git push" >&2
    exit 1
  fi
  n=0
  while read -r t; do [ "$(date -u -r "$t" +%Y-%m-%d 2>/dev/null)" = "$today" ] && n=$((n + 1)); done < "$LOG"
  if [ "$n" -ge "$DAY_MAX" ]; then
    echo "⏳ production push budget: ${n} pushes to main already today (UTC); the cap is ${DAY_MAX}. Next allowed after 00:00 UTC." >&2
    echo "   Broken live page: CDE_PUSH_NOW=1 git push" >&2
    exit 1
  fi
fi
echo "$now" >> "$LOG"
exit 0
