{
  "name": "childrendoenglish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-image-style.mjs && node scripts/pick-spotlight.mjs",
    "build": "vite build && node scripts/generate-seo-pages.js && node scripts/build-credits-page.mjs && node scripts/generate-og-images.js && node scripts/speculation-rules.mjs && node scripts/generate-sitemap.js",
    "postbuild": "node scripts/validate-schema.mjs --quiet && (node tools/seo/schema-gate.mjs dist | grep -E '^schema-gate|^  [A-Z]' || true)",
    "indexnow": "node tools/seo/indexnow-deploy.mjs --site childrendoenglish.com --log ../shared/seo-logs/index-pushes.jsonl",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build-data": "node scripts/build-word-data.js",
    "optimize-images": "node scripts/optimize-images.js",
    "engagement": "node tools/learning/optimizer.mjs 28 --rivals",
    "kit:smoke": "node ~/projects/shared/game-kit/tools/smoke.mjs https://childrendoenglish.com --site=cde",
    "kit:hreflang": "node ~/projects/shared/game-kit/infra/seo/hreflang-check.mjs --base=https://childrendoenglish.com",
    "kit:tap": "node ~/projects/shared/game-kit/test/site-tap-cover.mjs --base=https://childrendoenglish.com --pages=/,/games/,/he/,/es/,/vocabulary/,/units/,/printable-flashcards/ --query=internal=1",
    "kit:lang": "node ~/projects/shared/game-kit/test/language-leak.mjs --preset=cde",
    "kit:contrast": "node ~/projects/shared/game-kit/test/input-contrast.mjs --base=https://childrendoenglish.com --pages=/,/new-player,/vocabulary/,/units/",
    "kit:images": "node ~/projects/shared/game-kit/test/image-gate.mjs --config=~/projects/shared/game-kit/test/media-gates/cde.json",
    "kit:audio": "~/.venvs/whisper/bin/python ~/projects/shared/game-kit/test/audio-gate.py --config=~/projects/shared/game-kit/test/media-gates/cde.json",
    "kit:creds": "node ~/projects/shared/game-kit/tools/cred-health.mjs cde",
    "engagement:digest": "node tools/learning/optimizer.mjs 28 --rivals --digest",
    "spend": "node scripts/spend-check.mjs",
    "errors": "node scripts/errors-check.mjs",
    "index-sample": "~/.config/searchconsole/venv/bin/python tools/seo/index-sample.py 20",
    "kit:all": "node scripts/kit-all.mjs",
    "spotlight:review": "node scripts/spotlight-review.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/browser": "^10.43.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  }
}
